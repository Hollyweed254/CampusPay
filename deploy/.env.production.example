# CampusPay — production environment template.
# Copy to .env on the server, fill in every blank, then: chmod 600 .env
# Never commit the filled-in file.

APP_NAME=CampusPay
APP_ENV=production
APP_DEBUG=false
# 32 random bytes, base64-encoded:  php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# Empty when served from a domain root (https://pay.example.com).
# Use /CampusPay when served from a subdirectory of another site.
APP_BASE_PATH=

# Public hostname of this deployment; used for alert From addresses.
APP_URL=https://pay.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campuspay
DB_USER=campuspay
DB_PASS=

SESSION_NAME=CPSESSID
SESSION_LIFETIME_MINUTES=120

# Safaricom Daraja. Production values live in the Daraja portal, not in tests.
DARAJA_ENV=production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_CALLBACK_URL=https://pay.example.com/api/mpesa/callback/REPLACE_WITH_TOKEN
# php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
DARAJA_CALLBACK_TOKEN=
DARAJA_CALLBACK_IPS=

# First administrator, used once by database/seed-admin.php.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Nightly backups (bin/campuspay-backup.php). BACKUP_DIR defaults to
# storage/backups; point it at a disk outside the web root if you prefer.
BACKUP_DIR=
BACKUP_RETENTION_DAYS=14
BACKUP_MYSQLDUMP=mysqldump
# Off-host copy; receives the dump path as {file}. Example with rclone:
# BACKUP_UPLOAD_COMMAND=rclone copy {file} remote:campuspay-backups
BACKUP_UPLOAD_COMMAND=

# Error alerting. Webhook gets {"text": "..."} (Slack/Discord/generic).
ERROR_ALERT_WEBHOOK=
ERROR_ALERT_EMAIL=
