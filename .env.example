# Copy to .env and fill in real values. Never commit .env.
APP_NAME=CampusPay
APP_ENV=local
APP_DEBUG=true
# 32 random bytes, base64-encoded. Generate: php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# Path this app is served under (Alias in Apache). Empty = auto-detect from SCRIPT_NAME.
APP_BASE_PATH=/CampusPay

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campuspay
DB_USER=root
DB_PASS=

SESSION_NAME=CPSESSID
SESSION_LIFETIME_MINUTES=120

# Safaricom Daraja. Leave blank until you have sandbox/production credentials.
# Never commit real values. STK Push stays closed until all five credential
# fields below and DARAJA_CALLBACK_TOKEN are set.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Paybill: CustomerPayBillOnline. Buy goods (till): CustomerBuyGoodsOnline.
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public URL Safaricom can reach. Empty = derive from the current host + token.
DARAJA_CALLBACK_URL=
# Random URL secret; generate: php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
DARAJA_CALLBACK_TOKEN=
# Optional comma-separated Safaricom source IPs. Empty = token only.
DARAJA_CALLBACK_IPS=

# Used only by database/seed-admin.php
ADMIN_EMAIL=admin@campuspay.local
ADMIN_PASSWORD=
